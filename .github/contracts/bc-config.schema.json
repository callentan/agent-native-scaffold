{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-native-scaffold:bc-config:1",
  "title": "Optional bounded-context data configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "boundedContexts", "domainSources", "developmentRegistration"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "projectId": {"$ref": "#/$defs/identifier"},
    "boundedContexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"$ref": "#/$defs/identifier"}}
      }
    },
    "domainSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/domainSource"}
    },
    "developmentRegistration": {
      "type": "string",
      "pattern": "^[^\\s:#][^:#]*#[A-Za-z][A-Za-z0-9._:-]*$",
      "not": {"pattern": "(^/|/$|/#|//|(^|/)\\.{1,2}(/|#|$)|[\\\\\\r\\n])"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "\\s"}
    },
    "repoPath": {
      "anyOf": [
        {"const": "."},
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {"pattern": "(^/|/$|//|(^|/)\\.{1,2}(/|$)|[\\\\:#\\r\\n])"}
        }
      ]
    },
    "fixedBaseline": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$",
      "not": {"pattern": "\\s"}
    },
    "domainSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "root", "path", "baseline", "readOnly"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["local", "git"]},
        "root": {"$ref": "#/$defs/text"},
        "path": {"$ref": "#/$defs/repoPath"},
        "baseline": {"$ref": "#/$defs/fixedBaseline"},
        "readOnly": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "git"}}, "required": ["kind"]},
          "then": {
            "properties": {"baseline": {"pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}
          }
        }
      ]
    }
  }
}
