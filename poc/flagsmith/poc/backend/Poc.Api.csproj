<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
    <UserSecretsId>flagsmith-poc-backend</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenFeature" Version="2.14.1" />
    <PackageReference Include="OpenFeature.Contrib.Providers.Flagsmith" Version="0.3.1" />
    <PackageReference Include="Flagsmith" Version="9.0.0" />
    <Content Include="..\shared\demo-users.json"
             Link="demo-users.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>